def square_all(arr):
    # Use map() with lambda to square all elements
    # Example: square_all([1,2,3]) -> [1,4,9]
    return list(map(lambda x: x**2, arr))

def filter_positive(arr):
    # Use filter() with lambda to get only positive numbers
    # Example: filter_positive([-1,2,-3,4]) -> [2,4]
    return list(filter(lambda x: x>0, arr))

def sort_by_length(words):
    # Use sorted() with lambda key to sort words by length
    # Example: sort_by_length(["apple", "pie", "banana"]) -> ["pie", "apple", "banana"]
    return sorted(words, key=lambda x: len(x))
