# TODO: Complete the control flow exercises

def classify_age(age):
    # If age >= 18, return "Adult"
    # Else, return "Minor"
    if age >= 18:
        return "Adult"
    else:
        return "Minor"

def get_grade(score):
    # If score >= 90, return "A"
    # Elif score >= 80, return "B"
    # Elif score >= 70, return "C"
    # Elif score >= 60, return "D"
    # Else, return "F"
    if score >= 90:
        return "A"
    elif score >= 80:
        return "B"
    elif score >= 70:
        return "C"
    elif score >= 60:
        return "D"
    else:
        return "F"

def check_temperature(temp):
    # If temp > 80, return "Hot"
    # Elif temp > 60, return "Warm"
    # Elif temp > 40, return "Cool"
    # Else, return "Cold"
    if temp > 80:
        return "Hot"
    elif temp > 60:
        return "Warm"
    elif temp > 40:
        return "Cool"
    else:
        return "Cold"

def is_even_or_odd(num):
    # If num % 2 == 0, return "Even"
    # Else, return "Odd"
    if num % 2 == 0:
        return "Even"
    else:
        return "Odd"

def get_discount(price):
    # If price >= 100, return 0.2 (20% discount)
    # Elif price >= 50, return 0.1 (10% discount)
    # Else, return 0.0 (no discount)
    if price >= 100:
        return 0.2
    elif price >= 50:
        return 0.1
    else:
        return 0.0

# Test your functions
print(classify_age(20))  # Should be "Adult"
print(get_grade(85))     # Should be "B"
print(check_temperature(75))  # Should be "Warm"
print(is_even_or_odd(7))  # Should be "Odd"
print(get_discount(120))  # Should be 0.2
